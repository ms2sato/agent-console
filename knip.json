{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "off",
    "unlisted": "warn",
    "binaries": "off",
    "unresolved": "warn",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/__tests__/**/*.test.mjs",
        "scripts/smoke/**/*.{ts,mjs}"
      ],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": [
        "concurrently"
      ]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/embedded-agent": {
      "entry": [
        "src/main.ts",
        "src/**/__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/server": {
      "entry": [
        "src/index.ts!",
        "src/shim.ts!",
        "src/app-context.ts",
        "src/**/__tests__/**/*.test.ts",
        "src/**/__tests__/**/*.isolated-test.ts",
        "src/**/__tests__/utils/**/*.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "pino-pretty",
        "@types/mock-fs",
        "mock-fs"
      ]
    },
    "packages/client": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/**/__tests__/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "autoprefixer",
        "postcss",
        "@tailwindcss/postcss",
        "tailwindcss",
        "@types/diff",
        "class-variance-authority",
        "happy-dom"
      ]
    },
    "packages/integration": {
      "entry": [
        "src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
