{
  "name": "agent-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:multiuser": "./scripts/dev-multiuser.sh",
    "build": "bun run --filter '@agent-console/shared' build && bun run --filter '@agent-console/client' build && bun run --filter '@agent-console/server' build",
    "start": "NODE_ENV=production bun dist/index.js",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run typecheck && bun run test:only",
    "test:only": "bun run --filter '*' test && bun run test:scripts",
    "test:scripts": "bun test scripts/ ./.claude/hooks/__tests__/ ./.claude/skills/*/__tests__/",
    "test:coverage": "bun run --filter '*' test:coverage",
    "check:lang": "bun scripts/check-public-artifacts-language.mjs",
    "check:mock-module": "bun scripts/check-mock-module-poisoners.mjs",
    "check:preview-sandbox-browser": "bun scripts/run-preview-sandbox-browser-check.mjs",
    "check:pty-fd-leak": "bun scripts/smoke/check-pty-fd-leak.ts",
    "check:pty-early-output": "bun scripts/smoke/check-pty-early-output.ts",
    "check:pty-als-data": "bun scripts/smoke/check-pty-als-data.ts",
    "hooks:install": "bun scripts/install-hooks.mjs",
    "preinstall": "bun scripts/check-bun-version.mjs",
    "postinstall": "bun scripts/install-hooks.mjs",
    "lint": "bun run lint:structure",
    "lint:structure": "bun run lint:deps && bun run lint:cycles && bun run lint:unused",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json packages",
    "lint:deps:all": "depcruise --config .dependency-cruiser.cjs packages",
    "lint:deps:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline packages > .dependency-cruiser-known-violations.json",
    "lint:cycles": "madge --circular --extensions ts,tsx packages",
    "lint:cycles:all": "madge --circular --extensions ts,tsx --exclude '^$' packages",
    "lint:unused": "knip",
    "graph:deps": "depcruise --config .dependency-cruiser.cjs --output-type dot packages | dot -T svg -o dependency-graph.svg",
    "release": "bumpp"
  },
  "devDependencies": {
    "bumpp": "^10.1.0",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.3.10",
    "knip": "^6.4.1",
    "madge": "^8.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {}
}
